{
  "name": "pocket-butler-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "VITE_COMMIT=${BUTLER_COMMIT_SHA:-${RAILWAY_GIT_COMMIT_SHA:-dev}} vite build",
    "typecheck": "tsc --noEmit",
    "start": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000}"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serve": "^14.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
